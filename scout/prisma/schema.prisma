generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  audience    String?
  tone        String?
  history     String?
  doList      String?
  dontList    String?
  searchTerms String?
  email       String
  sendTime    String   @default("07:00")
  ideasPerRun Int      @default(3)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ideas       Idea[]
}

model Idea {
  id            String   @id @default(cuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  headline      String
  platform      String
  format        String
  whyNow        String
  execution     String
  score         Int
  sourceSignals String?
  imageUrl      String?
  createdAt     DateTime @default(now())
}

model AgencyProfile {
  id          String   @id @default(cuid())
  name        String
  tagline     String?
  strengths   String?
  pastWork    String?
  industries  String?
  style       String?
  credentials String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prospect {
  id          String   @id @default(cuid())
  companyName String
  website     String?
  industry    String?
  description String?
  signals     String?
  painPoints  String?
  whyFit      String?
  fitScore    Int      @default(0)
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pitches     Pitch[]
}

model Pitch {
  id           String   @id @default(cuid())
  prospectId   String
  prospect     Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  bigIdea      String
  hook         String
  situation    String
  insight      String
  concept      String
  execution    String
  whyUs        String
  whyNow       String
  callToAction String
  dataPoints   String?
  createdAt    DateTime @default(now())
}
